// Mahek Balloon — data model
//
// Postgres (Supabase). Prisma 7 no longer accepts `url`/`directUrl` here —
// connection URLs live in prisma.config.ts for the CLI, and lib/prisma.ts
// passes one explicitly to PrismaClient at runtime.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?      @db.Text
  image       String?
  type        CategoryType @default(PRODUCT)
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  products Product[]

  @@index([type])
  @@index([isActive])
  @@map("categories")
}

enum CategoryType {
  PRODUCT
  SERVICE
  EVENT
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?  @db.Text
  shortDesc      String?  @db.VarChar(255)
  basePrice      Decimal  @db.Decimal(10, 2)
  salePrice      Decimal? @db.Decimal(10, 2)
  costPrice      Decimal? @db.Decimal(10, 2)
  // Advance % collected online to confirm an order of this product. Null falls
  // back to the store-wide ADVANCE_PERCENT (50). Editable per product in admin.
  advancePercent Int?
  sku            String?  @unique
  stock          Int      @default(0)
  weight         Float?
  images         Json     @default("[]")
  variants       Json?    @default("[]")
  specifications Json?    @default("[]")
  rating         Float    @default(0)
  reviewCount    Int      @default(0)
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  deliveryBadge  String?  @default("Same Day")
  tags           String?  @db.VarChar(500)
  seoTitle       String?  @db.VarChar(255)
  seoDesc        String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categoryId String
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  reviews    Review[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([slug])
  @@map("products")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  // Optional: Google sign-in creates a customer with no phone yet. Postgres
  // allows multiple NULLs under a UNIQUE constraint, so this stays unique.
  phone     String?  @unique
  password  String? // bcrypt hash — for optional customer account login
  address   Json?    @default("[]")
  wishlist  Json?    @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders   Order[]
  bookings Booking[]
  reviews  Review[]

  @@map("customers")
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod @default(COD)

  // Money. Every figure below is computed server-side from DB prices —
  // never from client-submitted values.
  subtotal       Decimal @db.Decimal(10, 2)
  discount       Decimal @default(0) @db.Decimal(10, 2)
  deliveryCharge Decimal @default(0) @db.Decimal(10, 2)
  gst            Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  // 50% advance model: an order is only CONFIRMED once advanceAmount is received.
  advancePercent Int     @default(50)
  advanceAmount  Decimal @db.Decimal(10, 2)
  amountPaid     Decimal @default(0) @db.Decimal(10, 2)
  balanceDue     Decimal @db.Decimal(10, 2)

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique

  // "Buy product + book setup": the customer also wants Mahek Balloons to set
  // the order up at their venue. The team calls with a setup quote, so no fee is
  // fixed here. Address/date/time are only set when setupRequested is true.
  setupRequested Boolean   @default(false)
  setupAddress   String?   @db.Text
  setupDate      DateTime?
  setupTime      String?

  shippingAddress Json
  billingAddress  Json?
  notes           String?   @db.Text
  trackingNumber  String?
  paidAt          DateTime?
  confirmedAt     DateTime?

  // Shop-pickup model: customers book a slot to collect the order fresh from
  // Saras Baug. Optional so historical/legacy orders remain valid.
  pickupDate DateTime?
  pickupTime String?

  // PICKUP (default) or DELIVERY. Delivery is only unlocked when the cart
  // subtotal reaches the threshold; enforced server-side in pricing.
  deliveryType DeliveryType @default(PICKUP)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Snapshot of who ordered, denormalised from Customer. customerId is
  // SetNull on delete, so without this an order loses all identity the moment
  // the customer row goes; it also makes the admin/table views readable
  // without a join.
  customerName  String?
  customerPhone String?

  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  couponId   String?
  coupon     Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items      OrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name      String
  price     Decimal @db.Decimal(10, 2)
  quantity  Int
  variant   Json?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum DeliveryType {
  PICKUP
  DELIVERY
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID // 50% advance received — order is confirmed, balance due on delivery
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  UPI
  CARD
  WALLET
}

model Booking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  eventType     String
  venue         String?
  eventDate     DateTime?
  eventTime     String?
  budget        Decimal?      @db.Decimal(10, 2)
  instructions  String?       @db.Text
  status        BookingStatus @default(NEW)
  followUpDate  DateTime?

  // Decoration bookings follow the same 50%-advance rule as orders.
  quotedAmount  Decimal?      @db.Decimal(10, 2)
  advanceAmount Decimal?      @db.Decimal(10, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)

  stripeSessionId   String?   @unique
  razorpayOrderId   String?
  razorpayPaymentId String?
  confirmedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Denormalised from Customer so admin views show the name without a join.
  customerName  String?
  customerPhone String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("bookings")
}

enum BookingStatus {
  NEW
  FOLLOW_UP
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType @default(PERCENTAGE)
  value       Decimal    @db.Decimal(10, 2)
  minOrder    Decimal?   @db.Decimal(10, 2)
  maxDiscount Decimal?   @db.Decimal(10, 2)
  usageLimit  Int?
  usageCount  Int        @default(0)
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  orders Order[]

  @@map("coupons")
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Review {
  id         String   @id @default(cuid())
  rating     Int
  title      String?
  comment    String?  @db.Text
  // Name typed by a guest reviewer (no account). Falls back to the linked
  // customer's name when present.
  authorName String?
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([customerId])
  @@map("reviews")
}

model GalleryImage {
  id        String      @id @default(cuid())
  title     String?
  image     String
  category  String
  mediaType MediaKind   @default(IMAGE)
  // For a video: an optional still shown before playback / in grids.
  poster    String?
  isActive  Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([category])
  @@index([isActive])
  @@map("gallery_images")
}

enum MediaKind {
  IMAGE
  VIDEO
}

// Decoration services shown on /services. Admin-editable; getServices() reads
// this table and falls back to the static list in lib/content.ts when empty or
// the DB is unreachable.
model Service {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  priceFrom   Decimal  @db.Decimal(10, 2)
  image       String
  // Gallery images (string[]). The primary `image` is used as the hero;
  // `images` provides additional photos for the service gallery.
  images      Json     @default("[]")
  // string[] of bullet points, e.g. ["Theme customization", "Setup & takedown"]
  features    Json     @default("[]")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([slug])
  @@map("services")
}

model DeliveryCharge {
  id          String   @id @default(cuid())
  minDistance Int
  maxDistance Int
  charge      Decimal  @db.Decimal(10, 2)
  freeAbove   Decimal? @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("delivery_charges")
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("subscribers")
}

/// Uploaded image bytes.
///
/// Uploads used to be embedded in product/gallery rows as base64 data URLs,
/// which meant every image was inlined into the HTML *and* the RSC payload —
/// five photos added ~600 KB to the homepage. Rows here are served by
/// /api/media/[id] with an immutable cache header, so pages carry only a short
/// URL and browsers/CDN cache the bytes separately.
model Media {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())

  @@map("media")
}

/// Customer review videos rendered in a public carousel.
///
/// `videoUrl` accepts anything the browser can load — a `/api/media/<id>` URL
/// from the built-in uploader, a Cloudinary MP4 URL, or a YouTube watch URL —
/// so the shop can move to Cloudinary later without a schema change.
model ReviewVideo {
  id           String   @id @default(cuid())
  customerName String
  eventType    String // birthday, wedding, baby-shower, corporate, proposal, other
  rating       Int      @default(5) // 1-5
  reviewText   String?  @db.Text
  videoUrl     String
  poster       String? // thumbnail image URL
  duration     Int? // seconds, optional
  isFeatured   Boolean  @default(false)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([isFeatured])
  @@index([sortOrder])
  @@map("review_videos")
}

/// Themed promotional pages — "Vacation", "Rainy Season", "Exclusive", etc.
/// Fully admin-managed. An offer can showcase products from a linked category
/// and surface a coupon code the customer copies at checkout.
model Offer {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  badge         String? // short tag e.g. "Vacation Special"
  subtitle      String?   @db.VarChar(300)
  description   String?   @db.Text
  image         String? // banner, via the media uploader
  discountLabel String? // free text e.g. "Up to 30% OFF"
  couponCode    String? // code shown on the page; validated at checkout as usual
  ctaLabel      String?
  ctaHref       String?
  categorySlug  String? // products from this category are shown on the offer page
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive])
  @@index([slug])
  @@map("offers")
}

/// Single-row content model for the /about page. Fully admin-editable.
/// The row id is always "main"; getAboutContent() creates it on first read.
model AboutPage {
  id              String   @id @default("main")
  title           String?
  highlight       String?
  description     String?  @db.Text
  storyImage      String?
  // Story paragraphs as string[] JSON — one per line in the admin editor.
  story           Json     @default("[]")
  yearsExperience String?
  happyCustomers  String?
  eventsDecorated String?
  awardsWon       String?
  ctaTitle        String?
  ctaSubtitle     String?
  updatedAt       DateTime @updatedAt

  @@map("about_page")
}

model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String   @db.Text
  image     String
  ctaLabel  String?
  ctaHref   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero_slides")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  @@map("settings")
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String // bcrypt hash
  role        UserRole  @default(ADMIN)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("users")
}

enum UserRole {
  ADMIN
  STAFF
}
